syntax = "v1"

// ===== 通用响应 =====

// ===== 用户认证 =====

type (
	LoginRequest {
		Email    string `json:"email" validate:"required,email"`
		Password string `json:"password" validate:"required,min=6"`
	}

	LoginResponse {
		Token    string    `json:"token"`
		User     UserInfo  `json:"user"`
	}

	SignupRequest {
		Name     string `json:"name" validate:"required,min=2"`
		Email    string `json:"email" validate:"required,email"`
		Password string `json:"password" validate:"required,min=8"`
	}

	SignupResponse {
		Token string   `json:"token"`
		User  UserInfo `json:"user"`
	}

	UserInfo {
		Id     int64  `json:"id"`
		Name   string `json:"name"`
		Email  string `json:"email"`
		Role   string `json:"role"`
		Avatar string `json:"avatar,omitempty"`
	}

	GetUserResponse {
		User UserInfo `json:"user"`
	}
)

service mindray-api {
	@handler LoginHandler
	post /api/v1/auth/login (LoginRequest) returns (LoginResponse)

	@handler SignupHandler
	post /api/v1/auth/signup (SignupRequest) returns (SignupResponse)

	@server (
		jwt: Auth
		group: "user"
	)
	@handler GetUserHandler
	get /api/v1/user/profile returns (GetUserResponse)

	@server (
		jwt: Auth
		group: "user"
	)
	@handler UpdateUserHandler
	put /api/v1/user/profile (UserInfo) returns (GetUserResponse)
}
