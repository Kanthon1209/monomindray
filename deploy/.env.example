# Copy to deploy/.env (local) or /home/kanthon/mindray/deploy/.env (ECS). Never commit real secrets.

DB_USER=mindray
DB_PASSWORD=change_me
DB_NAME=mindray
JWT_SECRET=change_me_to_a_long_random_string

# Image tag deployed on ECS (git sha). CI sets this automatically.
IMAGE_TAG=latest

# Caddy hosts for Let's Encrypt (comma-separated OK)
SITE_ADDRESS=www.mindcollect.xyz, mindcollect.xyz
# Single host used in IP→domain redirects
CANONICAL_HOST=www.mindcollect.xyz
# Public ECS IP — http(s)://IP redirects to https://CANONICAL_HOST
REDIRECT_IP=115.29.235.41

# pgAdmin — http://<host>/pgadmin  (also :5050). Set a strong password.
PGADMIN_EMAIL=admin@mindray.com
PGADMIN_PASSWORD=change_me_pgadmin
