# Domain mode. .env:
#   SITE_ADDRESS=www.mindcollect.xyz, mindcollect.xyz
#   CANONICAL_HOST=www.mindcollect.xyz
#   REDIRECT_IP=<public ECS IP>
{
	default_sni {$REDIRECT_IP:127.0.0.2}
}

(app) {
	log {
		output stdout
		format json
	}

	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@pgadmin_noslash path /pgadmin
	redir @pgadmin_noslash /pgadmin/ 308

	handle /pgadmin* {
		reverse_proxy pgadmin:80
	}

	@grafana_noslash path /grafana
	redir @grafana_noslash /grafana/ 308

	handle /grafana* {
		reverse_proxy grafana:3000
	}

	handle {
		reverse_proxy web:3000
	}

	encode gzip zstd
}

{$SITE_ADDRESS::80} {
	import app
}

# http://IP → https://domain, except /api (phones often get TCP reset on 443)
http://{$REDIRECT_IP:127.0.0.2} {
	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	@to_https {
		not path /.well-known/acme-challenge/*
		not path /api/*
	}
	redir @to_https https://{$CANONICAL_HOST:localhost}{uri} 302
}

# https://IP → https://domain
# IP certs require Let's Encrypt "shortlived" profile (default profile rejects IPs).
{$REDIRECT_IP:127.0.0.2} {
	tls {
		issuer acme {
			profile shortlived
			disable_tlsalpn_challenge
		}
	}
	redir https://{$CANONICAL_HOST:localhost}{uri} 302
}
